{
  "name": "kari-manager",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:ui": "playwright test",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "verify": "npm run typecheck && npm test",
    "format": "prettier --write src tests \"*config.ts\" package.json tsconfig.json",
    "portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/portable.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2",
    "vite": "^6.3.6",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
